{
  "name": "requestscope",
  "version": "1.4.0",
  "private": true,
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "npm --workspace api run dev",
    "audit:html": "node scripts/audit-html.mjs web/index.html web/privacy.html",
    "test": "npm run audit:html && node --test scripts/static.test.mjs && npm --workspace api test",
    "test:browser": "node scripts/browser.test.mjs",
    "typecheck": "npm --workspace api run typecheck",
    "deploy:api": "npm --workspace api run deploy --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
